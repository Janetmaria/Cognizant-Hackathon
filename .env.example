# Environment variables for the Retail Sales Forecasting Platform
# Copy this file to .env and fill in real values before running locally.
# Never commit .env to version control.

# ── Auth (Module 8) ──────────────────────────────────────────────────────────
# Strong random secret for signing JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_before_production_use

# JWT algorithm — do not change unless you know what you're doing
ALGORITHM=HS256

# Token expiry in seconds (28800 = 8 hours, per api_contract.md v2)
ACCESS_TOKEN_EXPIRE_SECONDS=28800

# ── LLM Insights (Module 8) ──────────────────────────────────────────────────
# Google Gemini API key — get one at https://aistudio.google.com/apikey
# If left blank, /insights will always return "generated_by": "fallback"
GEMINI_API_KEY=your-gemini-api-key-here
