# =============================================================================
# LLM API Keys for Module 8 - Executive Insights
# =============================================================================
# Copy this file to .env and fill in your API key.
# The code tries providers in this order: Groq → OpenAI → Generic LLM.
# If none are set, it falls back to the deterministic template generator.

# ---- OPTION 1: Groq (Recommended - Free & Fast) ----
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b   # default, other options: openai/gpt-oss-20b, qwen/qwen3.6-27b

# ---- OPTION 2: OpenAI ----
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini             # default

# ---- OPTION 3: Generic OpenAI-compatible endpoint (e.g. Ollama, Together AI) ----
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.together.xyz/v1/chat/completions
# LLM_MODEL=meta-llama/Llama-3-70b-chat-hf

# =============================================================================
# Other Settings
# =============================================================================
# JWT_SECRET_KEY=your_custom_jwt_secret_here   # optional, has a safe default
# ACCESS_TOKEN_EXPIRE_MINUTES=480               # optional, default = 8 hours
